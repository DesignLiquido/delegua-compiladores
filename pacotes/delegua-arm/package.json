{
  "name": "delegua-arm",
  "version": "0.0.1",
  "description": "Compilador Delégua para binários ARM via GNU Assembler, sem LLVM.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "delegua-arm": "./dist/ilc.js"
  },
  "author": "Leonel Sanches da Silva",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
