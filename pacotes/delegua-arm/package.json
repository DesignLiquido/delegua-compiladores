  },
  "dependencies": {
    "@designliquido/delegua": "*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "jest": "^30.0.2",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
