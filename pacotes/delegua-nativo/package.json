{
  "name": "delegua-nativo",
  "version": "0.3.0",
  "description": "Compilador completo Delégua para código nativo via LLVM e Clang.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "delegua-nativo": "./dist/ilc.js"
  },
  "author": "Leonel Sanches da Silva",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "empacotar": "yarn rimraf ./dist && yarn tsc && yarn copyfiles -V ./package.json ./dist && yarn copyfiles -u 1 \"fontes/bibliotecas/**\" ./dist",
    "testes-unitarios": "yarn jest --coverage --passWithNoTests",
    "executar": "yarn ts-node fontes/ilc.ts",
    "prepublishOnly": "yarn empacotar"
  },
  "dependencies": {
    "@designliquido/delegua-llvm": "^9.1.0"
  },
  "devDependencies": {
    "@types/estree": "^1.0.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "copyfiles": "^2.4.1",
    "jest": "^30.0.2",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
